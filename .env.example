# ── Aplikasi ─────────────────────────────────────────────
APP_URL=http://localhost:3000
NODE_ENV=development
DATABASE_URL=./data/app.db

# Kunci enkripsi AES-256-GCM (WAJIB). Buat dengan:
#   openssl rand -hex 32
APP_ENCRYPTION_KEY=ganti-dengan-64-karakter-hex

# Admin awal (dipakai hanya saat seed pertama)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Secret untuk cron & komunikasi worker WhatsApp
CRON_SECRET=buat-secret-acak-panjang
INTERNAL_SECRET=buat-secret-acak-panjang
WA_WORKER_URL=http://127.0.0.1:3001
# WA_WORKER_PORT=3001

# Token DigitalOcean, payment gateway, SMTP, dan Turnstile diatur dari panel admin.
